+//   4-Bit-Kachel, I=64   5 143 us
+//   4-Bit-Kachel, I=128  5 559 us
+// Richtigkeit war in Ordnung (2/2 backends passed) — es lohnt nur nicht.
+#ifndef GGML_MMQ_IQ4NL_4BIT_TILE
