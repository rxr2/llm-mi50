+//
+// WARUM DAS HIER STEHT UND NICHT VIERMAL KOPIERT: am 2026-08-31 ist genau diese
+// Fallunterscheidung beim Umzug auf master still veraltet. Der Standardkernel bekam
+// upstream GGML_GLU_OP_SWIGLU_CLAMP dazu, meine vier Kopien nicht — und weil sie in
+// eigenen Regionen der Datei stehen, lief die Zusammenfuehrung ohne Konflikt durch.
+// Gefallen ist es erst in test-backend-ops -o MUL_MAT_VEC_FUSION (1258/1262), das ich
+// bis dahin nie gefahren hatte. Eine Fassung, ein Ort, kein Nachziehen.
+//
+// x_scale/gate_scale gibt es nur fuer NVFP4 und bleiben hier ausgeschlossen.
+static __device__ __forceinline__ float ggml_cuda_gfx906_glu_epilog(
+        const ggml_cuda_mm_fusion_args_device & fusion, const bool use_gate,
+        const size_t versatz, float result, float gate_value) {
+
+    if (fusion.x_bias != nullptr) {
+        result += ((const float *) fusion.x_bias)[versatz];
+    }
+    if (!use_gate) {
+        return result;
+    }
+    if (fusion.gate_bias != nullptr) {
+        gate_value += ((const float *) fusion.gate_bias)[versatz];
+    }
+    switch (fusion.glu_op) {
+        case GGML_GLU_OP_SWIGLU:
+            return result * ggml_cuda_op_silu_single(gate_value);
+        case GGML_GLU_OP_GEGLU:
+            return result * ggml_cuda_op_gelu_single(gate_value);
+        case GGML_GLU_OP_SWIGLU_OAI:
+            return ggml_cuda_op_swiglu_oai_single(gate_value, result);
+        case GGML_GLU_OP_SWIGLU_CLAMP:
+            return ggml_cuda_op_swiglu_clamp_single(gate_value, result, fusion.glu_limit);
+        default:
+            return result * gate_value;
+    }
+}
