+#define GGML_Q4_BREIT_LOS(T, K) mul_mat_vec_q4_0_breit_gfx906_los<ncols, T, K>( \
+        vx, vy, fusion, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst, \
+        channel_ratio, nchannels_dst, stride_channel_x, stride_channel_y, stride_channel_dst, \
