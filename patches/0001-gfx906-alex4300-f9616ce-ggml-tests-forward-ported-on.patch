+template <int ncols>
+static void mul_mat_vec_q4_0_breit_gfx906_start(
+        const void * vx, const void * vy, const ggml_cuda_mm_fusion_args_device fusion, float * dst,
+        const int ncols_x, const int nrows_x, const int stride_row_x,
+        const int stride_col_y, const int stride_col_dst,
+        const uint3 channel_ratio, const int nchannels_dst, const int stride_channel_x,
+        const int stride_channel_y, const int stride_channel_dst,
+        const uint3 sample_ratio, const int nsamples_dst, const int stride_sample_x,
+        const int stride_sample_y, const int stride_sample_dst, cudaStream_t stream) {
+    // Verschmolzen (Gate/Bias/GLU) gibt es nur bei einer Spalte.
+    const bool verschmolzen = ncols == 1 && (fusion.gate != nullptr || fusion.x_bias != nullptr || fusion.gate_bias != nullptr);
+    // Threads je Zeile 16 (16 Zeilen je Gruppe): im Sweep vom 2026-09-02 bei 4096x14336 fuer
+    // n=1/2/4 die beste Wahl (54,5/54,2/60,4 us gegen 58,4/58,1/66,5 bei 8), bei n=8 gleichauf.
+    // KC 64, ab sechs Spalten 32 (LDS-Belegung, siehe Kernelkommentar). Beides per Umgebung
+    // uebersteuerbar (GGML_MMVQ_Q4_BREIT_TPR=8|16, GGML_MMVQ_Q4_BREIT_KC=32|64|128) fuer Messreihen.
+    static const int tpr_env = getenv("GGML_MMVQ_Q4_BREIT_TPR") ? atoi(getenv("GGML_MMVQ_Q4_BREIT_TPR")) : 0;
+    static const int kc_env  = getenv("GGML_MMVQ_Q4_BREIT_KC")  ? atoi(getenv("GGML_MMVQ_Q4_BREIT_KC"))  : 0;
+    // n=5 und n=7 liefen mit 16 schlechter (80,7 gegen 76,3 und 105,5 gegen 94,2 us), dort 8.
+    // Gemessen nur an 4096x14336; fuer andere Formen ist das eine Annahme.
+    const int tpr = tpr_env ? tpr_env : ((ncols == 5 || ncols == 7) ? 8 : 16);
+    const int kc  = kc_env  ? kc_env  : (ncols > 5 ? 32 : 64);
+    // Zweiter Durchgang (2026-09-03): zwei Zeilen je Thread, mul_mat_vec_q4_0_breit2_gfx906.
+    // Gemessen 4096x14336, us, RPT 1 -> 2: n=4 60 -> 63, n=5 77 -> 70, n=6 78 -> 83, n=7 95 -> 109,
+    // n=8 104 -> 116 -- die Vorhersage "LDS-Lesungen begrenzen bei n=8" war falsch, nur n=5
+    // gewinnt. Vorgabe daher RPT=2 allein fuer ncols == 5; GGML_MMVQ_Q4_BREIT_RPT=1|2 zum Messen.
+    static const int rpt_env = getenv("GGML_MMVQ_Q4_BREIT_RPT") ? atoi(getenv("GGML_MMVQ_Q4_BREIT_RPT")) : 0;
+    const int rpt = rpt_env ? rpt_env : (ncols == 5 ? 2 : 1);
