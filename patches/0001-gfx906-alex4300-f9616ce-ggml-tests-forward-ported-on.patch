+// gfx906: Q5_K-GEMV, ein Thread je il-Gruppe (64 Gewichte, zwei ganze q8_1-Bloecke).
+//
+// Baugleich zu mul_mat_vec_q4_K_gfx906: Q5_K hat dieselbe qs-Aufteilung (32
+// zusammenhaengende Byte je il-Gruppe) und dasselbe dot2, das die Summe der
+// Aktivierungen nachrechnet, obwohl sie in ds.y steht. Neu ist nur qh — die 32 Byte
+// des fuenften Bits, die alle vier il-Gruppen gemeinsam nutzen und die sich nur im
+// Schiebebetrag (2*il) unterscheiden.
+//
+// Anteile in den Modellen hier: 14,7 % der Gewichte in Qwen3.8-27B-UD-IQ4_XS,
+// 12,2 % der Prefill-Zeit in Flash-Next.
+//
+// block_q5_K ist 176 Byte gross und damit 4-Byte-ausgerichtet — anders als
+// block_q6_K (210), hier geht der int-Zeiger direkt.
+static __device__ __forceinline__ float ggml_cuda_q5k_gfx906_gruppe(
+        const block_q5_K * __restrict__ bx, const int il,
+        const int * __restrict__ u0, const int * __restrict__ u1,
+        const float * __restrict__ d8, const float s8_0, const float s8_1) {
+
+    int vl[8], vh[8];
+    {
+        const int * ql = (const int *) (bx->qs + 32*il);
+        const int * qh = (const int *) bx->qh;
+#pragma unroll
+        for (int t = 0; t < 8; ++t) {
+            vl[t] = ql[t];
+            vh[t] = qh[t] >> (2*il);
+        }
+    }
+
+    // Skalen unveraendert aus dem Standardpfad, j = il (dort bq8_offset/2).
+    const uint16_t * scales = (const uint16_t *) bx->scales;
+    uint16_t aux[2];
+    const int j = il;
+    if (j < 2) {
+        aux[0] = scales[j+0] & 0x3f3f;
+        aux[1] = scales[j+2] & 0x3f3f;
+    } else {
+        aux[0] = ((scales[j+2] >> 0) & 0x0f0f) | ((scales[j-2] & 0xc0c0) >> 2);
+        aux[1] = ((scales[j+2] >> 4) & 0x0f0f) | ((scales[j-0] & 0xc0c0) >> 2);
+    }
+    const uint8_t * sc = (const uint8_t *) aux;
+    const uint8_t * m  = sc + 2;
+
+    float sumf_d = 0.0f;
+#pragma unroll
+    for (int k = 0; k < 4; ++k) {
+        const int vvl[2] = { vl[k], vl[k+4] };
+        const int vvh[2] = { vh[k], vh[k+4] };
+        const int uu[4]  = { u0[k], u0[k+4], u1[k], u1[k+4] };
+        sumf_d += vec_dot_q5_K_q8_1_impl_d_gfx906(vvl, vvh, uu, sc, d8);
+    }
+
+    const float2 dm5f = __half22float2(bx->dm);
+    return dm5f.x*sumf_d - dm5f.y*(s8_0*m[0] + s8_1*m[1]);
+}
+
+// Vorgabe an; mit GGML_MMVQ_Q5K_GFX906=0 abschaltbar.
+template <bool has_fusion>
+__launch_bounds__(64, 1)
+static __global__ void mul_mat_vec_q5_K_gfx906(
+        const void * __restrict__ vx, const void * __restrict__ vy,
+        const ggml_cuda_mm_fusion_args_device fusion, float * __restrict__ dst,
+        const uint32_t ncols_x, const uint32_t nrows_x, const uint32_t stride_row_x,
+        const uint3 channel_ratio, const uint32_t stride_channel_x,
+        const uint32_t stride_channel_y, const uint32_t stride_channel_dst,
+        const uint3 sample_ratio, const uint32_t stride_sample_x,
+        const uint32_t stride_sample_y, const uint32_t stride_sample_dst) {
+
+    const int lane      = threadIdx.x;
+    const int half_lane = lane % 32;
+    const int row       = blockIdx.x * 2 + lane / 32;
+    if ((uint32_t) row >= nrows_x) {
+        return;
+    }
+
+    const uint32_t channel_dst = blockIdx.y;
+    const uint32_t channel_x   = fastdiv(channel_dst, channel_ratio);
+    const uint32_t sample_dst  = blockIdx.z;
+    const uint32_t sample_x    = fastdiv(sample_dst, sample_ratio);
+
+    const int blocks_per_row = ncols_x / QK_K;
+    const int groups_per_row = blocks_per_row * 4;   // je 64 Gewichte
+
+    const block_q5_K * x = (const block_q5_K *) vx
+        + sample_x*stride_sample_x + channel_x*stride_channel_x + (size_t) row*stride_row_x;
+    const block_q8_1 * y = (const block_q8_1 *) vy
+        + sample_dst*stride_sample_y + channel_dst*stride_channel_y;
+
+    [[maybe_unused]] const block_q5_K * xg = nullptr;
+    [[maybe_unused]] bool use_gate = false;
+    if constexpr (has_fusion) {
+        use_gate = fusion.gate != nullptr;
+        if (use_gate) {
+            xg = (const block_q5_K *) fusion.gate
+                + sample_x*stride_sample_x + channel_x*stride_channel_x + (size_t) row*stride_row_x;
+        }
+    }
+
+    float sumf  = 0.0f;
+    float sumfg = 0.0f;
+
+    for (int g = half_lane; g < groups_per_row; g += 32) {
+        const int ib = g / 4;
+        const int il = g % 4;
+
+        const block_q8_1 * by0 = y + ib*(QK_K/QK8_1) + 2*il;
+        const block_q8_1 * by1 = by0 + 1;
+
+        int u0[8], u1[8];
+#pragma unroll
+        for (int t = 0; t < 8; ++t) {
+            u0[t] = get_int_b4(by0->qs, t);
+            u1[t] = get_int_b4(by1->qs, t);
+        }
+
+        const float2 ds0 = __half22float2(by0->ds);
+        const float2 ds1 = __half22float2(by1->ds);
+        const float  d8[2] = { ds0.x, ds1.x };
+
+        sumf += ggml_cuda_q5k_gfx906_gruppe(x + ib, il, u0, u1, d8, ds0.y, ds1.y);
+
+        if constexpr (has_fusion) {
+            if (use_gate) {
+                sumfg += ggml_cuda_q5k_gfx906_gruppe(xg + ib, il, u0, u1, d8, ds0.y, ds1.y);
+            }
+        }
+    }
+
+    sumf = warp_reduce_sum<32>(sumf);
+    if constexpr (has_fusion) {
+        if (use_gate) {
+            sumfg = warp_reduce_sum<32>(sumfg);
+        }
+    }
+
+    if (half_lane != 0) {
+        return;
+    }
+
+    float result = sumf;
+    if constexpr (has_fusion) {
+        const size_t versatz = sample_dst*stride_sample_dst + channel_dst*stride_channel_dst + row;
+        result = ggml_cuda_gfx906_glu_epilog(fusion, use_gate, versatz, result, sumfg);
+    }
+
+    dst[sample_dst*stride_sample_dst + channel_dst*stride_channel_dst + row] = result;
+}
