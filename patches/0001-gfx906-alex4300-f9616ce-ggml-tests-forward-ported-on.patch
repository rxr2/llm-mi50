+#if defined(GGML_USE_HIP)
+// gfx906: Q4_K-GEMV, ein Thread je 64-Gewichte-Gruppe.
+//
+// Anlass: Q4_K setzt im Standardpfad **keinen einzigen** breiten Ladebefehl ab
+// (344x dword + 196x ushort, kein dwordx2/x4), waehrend IQ4_XS mit dwordx4 laedt und
+// das schnellste Format ist. Der Zaehler zeigt warum das zaehlt: bei n=1 ist
+// MemUnitBusy fuer alle Typen 80-91 %, aber SQ_INSTS_VMEM_RD steht bei 802 816
+// (Q4_K) gegen 172 032 (IQ4_XS) — die Speichereinheit ist mit *vielen schmalen
+// Anforderungen* ausgelastet, nicht mit Bytes.
+//
+// Eine Sonde, die alle verstreuten Zugriffe benachbart macht (bewusst falsches
+// Ergebnis), kam auf 344 064 Ladebefehle und **+12,6 % Decode**. Das ist die
+// Obergrenze, die dieser Kernel einzuloesen versucht.
+//
+// Aufbau: 32 zusammenhaengende Byte von qs[] sind genau eine il-Gruppe = 64 Gewichte
+// = zwei Unterbloecke (untere Nibbles -> Unterblock 2*il, obere -> 2*il+1). Ein
+// Thread nimmt die ganze Gruppe und liest sie als zwei dwordx4, dazu die beiden
+// zugehoerigen q8_1-Bloecke als je zwei dwordx4. Gerechnet wird danach viermal mit
+// vec_dot_q4_K_q8_1_impl_vmmq aus Registern — dieselbe Arithmetik wie im
+// Standardpfad, nur die Ladeform ist anders.
+//
+// Vorgabe an; mit GGML_MMVQ_Q4K_GFX906=0 abschaltbar.
+// Eine il-Gruppe (64 Gewichte = zwei ganze q8_1-Bloecke) einer Zeile gegen die
+// bereits geladene y-Seite rechnen. Bei verschmolzenen Aufrufen wird das zweimal
+// gerufen — einmal fuer die Gewichtsmatrix, einmal fuer das Gate — mit derselben
+// y-Seite. Genau das ist der Sinn der Verschmelzung: y wird einmal gelesen.
+static __device__ __forceinline__ float ggml_cuda_q4k_gfx906_gruppe(
+        const block_q4_K * __restrict__ bx, const int il,
+        const int * __restrict__ u0, const int * __restrict__ u1,
+        const float * __restrict__ d8, const float s8_0, const float s8_1) {
+
+    int v[8];
+    {
+        const int * q4 = (const int *) (bx->qs + 32*il);
+#pragma unroll
+        for (int t = 0; t < 8; ++t) {
+#if GGML_MMVQ_Q4K_OHNE_X
+            // Sonde: x nicht laden (bewusst falsch), y unberuehrt.
+            v[t] = 0x01010101;
+#else
+            v[t] = q4[t];
+#endif
+        }
+    }
+
+    // Skalen unveraendert aus dem Standardpfad — der Laufzeitindex greift in den
+    // globalen Speicher, nicht in ein lokales Feld. (Die Variante mit lokalem Feld
+    // ist am 2026-08-29 gemessen worden und kostete 26 %: Scratch statt L1.)
+    const uint16_t * scales = (const uint16_t *) bx->scales;
+    uint16_t aux[2];
+    const int j = il;
+#if GGML_MMVQ_Q4K_OHNE_META
+    // Sonde: Skalen nicht laden (bewusst falsch). Aendert genau eine Sache —
+    // die fuenf schmalen ushort-Zugriffe je Gruppe.
+    (void) scales; (void) j;
+    aux[0] = 0x0101;
+    aux[1] = 0x0101;
+#else
+    if (j < 2) {
+        aux[0] = scales[j+0] & 0x3f3f;
+        aux[1] = scales[j+2] & 0x3f3f;
+    } else {
+        aux[0] = ((scales[j+2] >> 0) & 0x0f0f) | ((scales[j-2] & 0xc0c0) >> 2);
+        aux[1] = ((scales[j+2] >> 4) & 0x0f0f) | ((scales[j-0] & 0xc0c0) >> 2);
+    }
+#endif // GGML_MMVQ_Q4K_OHNE_META
+    const uint8_t * sc = (const uint8_t *) aux;
+    const uint8_t * m  = sc + 2;
+
+#if GGML_MMVQ_Q4K_SUMME
+    // Die Summe der Aktivierungen steht schon in ds.y — nicht mit dp4a nachrechnen.
+    // Zulaessig, weil ein Thread mit einer il-Gruppe genau die beiden ganzen Bloecke
+    // by0 und by1 abdeckt (vier k-Durchgaenge x acht ints = 2 x 32 Quanten). Halbiert
+    // die dp4a; sc, m und dm sind ueber k konstant, also wandern m-Term und
+    // dm-Faktor mit aus der Schleife. Dieselbe Form benutzt die MMQ-Fassung laengst
+    // (vec_dot_q4_K_q8_1_impl_mmq: sumf_m += ds8f.y * m[i]).
+    float sumf_d = 0.0f;
+#pragma unroll
+    for (int k = 0; k < 4; ++k) {
+        const int vv[2] = { v[k], v[k+4] };
+        const int uu[4] = { u0[k], u0[k+4], u1[k], u1[k+4] };
+        sumf_d += vec_dot_q4_K_q8_1_impl_d_gfx906(vv, uu, sc, d8);
+    }
+    const float2 dm4f = __half22float2(bx->dm);
+    return dm4f.x*sumf_d - dm4f.y*(s8_0*m[0] + s8_1*m[1]);
+#else
+    (void) s8_0; (void) s8_1;
+    float sumf = 0.0f;
+#pragma unroll
+    for (int k = 0; k < 4; ++k) {
+        const int vv[2] = { v[k], v[k+4] };
+        const int uu[4] = { u0[k], u0[k+4], u1[k], u1[k+4] };
+        sumf += vec_dot_q4_K_q8_1_impl_vmmq(vv, uu, sc, m, bx->dm, d8);
+    }
+    return sumf;
+#endif // GGML_MMVQ_Q4K_SUMME
+}
+
+template <bool has_fusion>
+__launch_bounds__(64, 1)
+static __global__ void mul_mat_vec_q4_K_gfx906(
+        const void * __restrict__ vx, const void * __restrict__ vy,
+        const ggml_cuda_mm_fusion_args_device fusion, float * __restrict__ dst,
+        const uint32_t ncols_x, const uint32_t nrows_x, const uint32_t stride_row_x,
+        const uint3 channel_ratio, const uint32_t stride_channel_x,
+        const uint32_t stride_channel_y, const uint32_t stride_channel_dst,
+        const uint3 sample_ratio, const uint32_t stride_sample_x,
+        const uint32_t stride_sample_y, const uint32_t stride_sample_dst) {
+
+    const int lane      = threadIdx.x;
+    const int half_lane = lane % 32;
+    const int row       = blockIdx.x * 2 + lane / 32;
+    if ((uint32_t) row >= nrows_x) {
+        return;
+    }
+
+    const uint32_t channel_dst = blockIdx.y;
+    const uint32_t channel_x   = fastdiv(channel_dst, channel_ratio);
+    const uint32_t sample_dst  = blockIdx.z;
+    const uint32_t sample_x    = fastdiv(sample_dst, sample_ratio);
+
+    const int blocks_per_row = ncols_x / QK_K;      // Superbloecke à 256 Gewichte
+
+    const block_q4_K * x = (const block_q4_K *) vx
+        + sample_x*stride_sample_x + channel_x*stride_channel_x + (size_t) row*stride_row_x;
+    const block_q8_1 * y = (const block_q8_1 *) vy
+        + sample_dst*stride_sample_y + channel_dst*stride_channel_y;
+
+    // Verschmolzener Fall: dieselbe y-Seite gegen eine zweite Gewichtsmatrix.
+    // Vor dem 2026-09-01 lief dieser Fall am Sonderweg vorbei (Tor
+    // `fusion.gate == nullptr`) — und er ist der groessere: im Profil von
+    // Qwen3-8B-Q4_K_M standen 42,9 % der Decode-Zeit im verschmolzenen
+    // Standardkernel gegen 7,9 % hier.
+    [[maybe_unused]] const block_q4_K * xg = nullptr;
+    [[maybe_unused]] bool use_gate = false;
+    if constexpr (has_fusion) {
+        use_gate = fusion.gate != nullptr;
+        if (use_gate) {
+            xg = (const block_q4_K *) fusion.gate
+                + sample_x*stride_sample_x + channel_x*stride_channel_x + (size_t) row*stride_row_x;
+        }
+    }
+
+    const int groups_per_row = blocks_per_row * 4;  // je 64 Gewichte
+
+    float sumf  = 0.0f;
+    float sumfg = 0.0f;
+
+    for (int g = half_lane; g < groups_per_row; g += 32) {
+        const int ib = g / 4;
+        const int il = g % 4;
+
+        const block_q8_1 * by0 = y + ib*(QK_K/QK8_1) + 2*il;
+        const block_q8_1 * by1 = by0 + 1;
+
+        int u0[8], u1[8];
+#pragma unroll
+        for (int t = 0; t < 8; ++t) {
+#if GGML_MMVQ_Q4K_OHNE_Y
+            // Sonde: y nicht laden (bewusst falsch). Aendert genau eine Sache —
+            // die Zahl und Menge der y-Zugriffe — und laesst x unberuehrt.
+            u0[t] = 0x01010101;
+            u1[t] = 0x01010101;
+#else
+            u0[t] = get_int_b4(by0->qs, t);
+            u1[t] = get_int_b4(by1->qs, t);
+#endif
+        }
+
+        const float2 ds0 = __half22float2(by0->ds);
+        const float2 ds1 = __half22float2(by1->ds);
+        const float  d8[2] = { ds0.x, ds1.x };
+
+        sumf += ggml_cuda_q4k_gfx906_gruppe(x + ib, il, u0, u1, d8, ds0.y, ds1.y);
+
+        if constexpr (has_fusion) {
+            if (use_gate) {
+                sumfg += ggml_cuda_q4k_gfx906_gruppe(xg + ib, il, u0, u1, d8, ds0.y, ds1.y);
+            }
+        }
+    }
+
+    sumf = warp_reduce_sum<32>(sumf);
+    if constexpr (has_fusion) {
+        if (use_gate) {
+            sumfg = warp_reduce_sum<32>(sumfg);
+        }
+    }
+
+    if (half_lane != 0) {
+        return;
+    }
+
+    float result = sumf;
+    if constexpr (has_fusion) {
+        const size_t versatz = sample_dst*stride_sample_dst + channel_dst*stride_channel_dst + row;
+        result = ggml_cuda_gfx906_glu_epilog(fusion, use_gate, versatz, result, sumfg);
+    }
+
+    dst[sample_dst*stride_sample_dst + channel_dst*stride_channel_dst + row] = result;
+}
