+// gfx906: Q6_K-GEMV, ein Thread je 32-Gewichte-Gruppe.
+//
+// Anlass wie bei Q4_K: der Standardpfad setzt fuer Q6_K keinen einzigen breiten
+// Ladebefehl ab. Im Profil von Qwen3-8B-Q4_K_M standen nach der Q4_K-Arbeit
+// 12,0 % (verschmolzen) plus 9,8 % (unverschmolzen) der Decode-Zeit in
+// mul_mat_vec_q<Q6_K, ...> -- zusammen 21,8 % und damit der groesste Rest.
+//
+// Aufteilung: ein Thread nimmt vier aufeinanderfolgende ql-Ints (iqs = 4*j .. 4*j+3).
+// Damit liegen alle vier Quellen als je 16 zusammenhaengende Byte:
+//
+//   j | ql-Ints | qh-Ints | shift | scale | bq8 | u-Ints
+//   0 |  0.. 3  |  0.. 3  |   0   |   0   |  0  | 0..3
+//   1 |  4.. 7  |  4.. 7  |   0   |   1   |  0  | 4..7
+//   2 |  8..11  |  0.. 3  |   2   |   2   |  1  | 0..3
+//   3 | 12..15  |  4.. 7  |   2   |   3   |  1  | 4..7
+//   4 | 16..19  |  8..11  |   0   |   8   |  4  | 0..3
+//   5 | 20..23  | 12..15  |   0   |   9   |  4  | 4..7
+//   6 | 24..27  |  8..11  |   2   |  10   |  5  | 0..3
+//   7 | 28..31  | 12..15  |   2   |  11   |  5  | 4..7
+//
+// vh_shift, scale_offset und bq8_offset sind innerhalb eines Threads konstant --
+// im Standardpfad wechseln sie je Thread und je Aufruf.
+//
+// block_q6_K ist 210 Byte gross, also nur 2-Byte-ausgerichtet. Deshalb get_int_b2
+// statt eines int-Zeigers; gfx906 kann unausgerichtete Zugriffe, der Compiler fasst
+// die vier zusammen (nachgeprueft im Assembler, siehe Ergebnisdokument).
+static __device__ __forceinline__ float ggml_cuda_q6k_gfx906_gruppe(
+        const block_q6_K * __restrict__ bx, const int j,
+        const int * __restrict__ u0, const int * __restrict__ u1,
+        const float * __restrict__ d8) {
+
+    const int iqs0      = 4*j;
+    const int qh_basis  = 8*(iqs0/16) + iqs0 % 8;
+    const int vh_shift  = 2*((iqs0 % 16) / 8);
+    const int8_t * sc   = bx->scales + 8*(iqs0/16) + (iqs0 % 16)/4;
+
+    int vl[4], vh[4];
+#pragma unroll
+    for (int t = 0; t < 4; ++t) {
+        vl[t] = get_int_b2(bx->ql, iqs0 + t);
+        vh[t] = get_int_b2(bx->qh, qh_basis + t) >> vh_shift;
+    }
+
+    float sumf = 0.0f;
+#pragma unroll
+    for (int t = 0; t < 4; ++t) {
+#pragma unroll
+        for (int i = 0; i < QR6_K; ++i) {
+            const int vil = (vl[t] >> (4*i)) & 0x0F0F0F0F;
+            const int vih = ((vh[t] >> (4*i)) << 4) & 0x30303030;
+            const int vi  = __vsubss4((vil | vih), 0x20202020); // vi = (vil | vih) - 32
+            const int u   = (i == 0) ? u0[t] : u1[t];
+            sumf += d8[i] * (ggml_cuda_dp4a(vi, u, 0) * sc[4*i]);
+        }
+    }
+
+    return __half2float(bx->d) * sumf;
+}
