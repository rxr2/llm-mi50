diff --git a/ggml/src/ggml-cuda/mmq-config-gcn5.cuh b/ggml/src/ggml-cuda/mmq-config-gcn5.cuh
new file mode 100644
index 000000000..fdce83f3b
--- /dev/null
+++ b/ggml/src/ggml-cuda/mmq-config-gcn5.cuh
@@ -0,0 +1,353 @@
+// MMQ-Profil fuer gfx906/Vega20 (GCN5).
+//
+// Ohne diese Datei faellt gfx906 auf das RDNA2-Profil durch. Das passt in allem
+// ausser einem: RDNA2 hat 128 KiB LDS je WGP, gfx906 nur **64 KiB je CU**. Mit
+// I=128 braucht ein Block je nach Typ 37–60 KiB, es passt also nur **einer** auf
+// eine CU — vier Wellen, also **eine Welle je SIMD**. Auf einer Architektur ohne
+// Scoreboard ist damit jeder s_waitcnt tote Zeit, und kein Hardwarezaehler zeigt
+// einen Grund an: MemUnitStalled 0 %, ALUStalledByLDS 0,2 %, VALUUtilization 100 %,
+// nur VALUBusy faellt von 58 auf 37 %.
+//
+// Genau zwei Typen entgehen dem: Q4_0 und Q4_1 legen 4 Bit je Gewicht ins LDS und
+// kommen auf 30,6 KiB — zwei Bloecke. Das war der ganze Vorsprung von Q4_0.
+//
+// Mit I=64 passen alle uebrigen Typen zweimal. Gemessen (m=4096, k=14336, n=512):
+// q5_K −39,8 %, iq3_s −17,2 %, q8_0 −16,6 %, iq4_nl −14,3 %, q6_K −13,7 %,
+// iq4_xs −10,2 %. Q4_0 (+2,7 %) und Q4_K (+11,9 %) verlieren dabei und behalten
+// deshalb I=128 — sie zahlen die geringere Kachelwiederverwendung, ohne Belegung
+// zu gewinnen. Q2_K ebenfalls: es kommt auch mit I=64 auf 34,6 KiB und damit
+// weiterhin nur auf einen Block — I=64 kostet dort nur Wiederverwendung (+66 %).
+//
+// werkzeuge/lds_belegung.py rechnet die Bloecke je CU fuer jede Kombination aus.
+// Einzelheiten in ergebnis-lds-kachelbreite-2026-08-30.md.
+
+#ifndef GGML_MMQ_I_GCN5_BREIT
+#define GGML_MMQ_I_GCN5_BREIT 64
+#endif
+#ifndef GGML_MMQ_I_GCN5_SCHMAL
+#define GGML_MMQ_I_GCN5_SCHMAL 128
+#endif
+
+// Belegungsvorgabe (zweites CASE-Feld) landet in __launch_bounds__(nthreads, N) und
+// deckelt damit die Register: N=2 bedeutet hoechstens 128 VGPR je Thread. Fuer Typen,
+// die wegen des LDS ohnehin nur einen Block je CU bekommen, ist das eine Vorgabe ohne
+// Gegenwert — der Registerdruck wird zu Auslagerung nach scratch.
+// Q2_K bei I=128: 128 VGPR am Anschlag und **2 600 Byte scratch**, neun global_load
