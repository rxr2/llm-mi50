+// gfx906: IQ4_NL-GEMV, ein Thread je Block.
+//
+// block_iq4_nl hat wie block_q4_0 achtzehn Byte (2 B Skalar + 16 B Nibbles), die
+// Nutzlast passt also in EINEN global_load_dwordx4 — der Fall, in dem sich diese
+// Struktur bewährt hat (Q4_0: -16 %; Q8_0 mit 32 B Nutzlast dagegen +21 %).
+//
+// Unterschied zu Q4_0 nur beim Entpacken: Tabellenauflösung über
+// get_int_from_table_16, das auf HIP zu vier v_perm_b32 wird und keinen
+// Speicherzugriff braucht.
+//
+// Mit GGML_MMVQ_IQ4NL_GFX906=1 einschaltbar.
+__launch_bounds__(64, 1)
+static __global__ void mul_mat_vec_iq4_nl_gfx906(
+        const void * __restrict__ vx, const void * __restrict__ vy, float * __restrict__ dst,
+        const uint32_t ncols_x, const uint32_t nrows_x, const uint32_t stride_row_x,
+        const uint3 channel_ratio, const uint32_t stride_channel_x,
+        const uint32_t stride_channel_y, const uint32_t stride_channel_dst,
+        const uint3 sample_ratio, const uint32_t stride_sample_x,
+        const uint32_t stride_sample_y, const uint32_t stride_sample_dst) {
+
+    const int lane      = threadIdx.x;
+    const int half_lane = lane % 32;
+    const int row       = blockIdx.x * 2 + lane / 32;
+    if ((uint32_t) row >= nrows_x) {
+        return;
+    }
+
+    const uint32_t channel_dst = blockIdx.y;
+    const uint32_t channel_x   = fastdiv(channel_dst, channel_ratio);
+    const uint32_t sample_dst  = blockIdx.z;
+    const uint32_t sample_x    = fastdiv(sample_dst, sample_ratio);
+
+    const int blocks_per_row = ncols_x / QK4_NL;
+
+    const block_iq4_nl * x = (const block_iq4_nl *) vx
+        + sample_x*stride_sample_x + channel_x*stride_channel_x + (size_t) row*stride_row_x;
+    const block_q8_1 * y = (const block_q8_1 *) vy
+        + sample_dst*stride_sample_y + channel_dst*stride_channel_y;
+
+    float sumf = 0.0f;
+    for (int ib = half_lane; ib < blocks_per_row; ib += 32) {
+        const block_iq4_nl * bx = x + ib;
+        const block_q8_1   * by = y + ib;
+
+        const int * q8 = (const int *) by->qs;
+        int sumi = 0;
+#pragma unroll
+        for (int l = 0; l < 4; ++l) {
+            const int  aux_q4 = get_int_b2(bx->qs, l);
+            const int2 v      = get_int_from_table_16(aux_q4, kvalues_iq4nl);
+            sumi = ggml_cuda_dp4a(v.x, q8[l + 0], sumi);
+            sumi = ggml_cuda_dp4a(v.y, q8[l + 4], sumi);
+        }
+
+        sumf += __half2float(bx->d) * __low2float(by->ds) * (float) sumi;
+    }
+
+    sumf = warp_reduce_sum<32>(sumf);
+
+    if (half_lane == 0) {
+        dst[sample_dst*stride_sample_dst + channel_dst*stride_channel_dst + row] = sumf;
+    }
+}
