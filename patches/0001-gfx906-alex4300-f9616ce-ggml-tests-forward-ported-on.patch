+// IQ4_NL und MXFP4 in der float2-Form, damit get_rows sie über den allgemeinen
+// Kernel k_get_rows<qk,qr,dq> abwickeln kann statt über den Superblock-Kernel.
+//
+// Beide haben 32er-Blöcke mit derselben Anordnung wie Q4_0: ein Skalar je Block,
+// niedriges Nibble nach Position j, hohes nach j+16 (vgl. dequantize_row_iq4_nl und
+// dequantize_row_mxfp4 in ggml-quants.c). Nur die Wertzuordnung ist eine Tabelle
+// statt "Nibble - 8".
+//
+// Damit entfällt die Bedingung ne0 % QK_K == 0 in ggml_backend_cuda_device_supports_op:
+// die kam nicht vom Format, sondern davon, dass k_get_rows_kq in 256er-Superblöcken
+// iteriert. Zeilenlängen, die nur ein Vielfaches von 32 sind, fielen dadurch auf die
+// CPU zurück — und rissen den Graphen mit.
+
+static __device__ __forceinline__ void dequantize_iq4_nl_b32(const void * vx, const int64_t ib, const int iqs, float2 & v){
+    const block_iq4_nl * x = (const block_iq4_nl *) vx;
+
+    const float d   = __half2float(x[ib].d);
+    const int   vui = x[ib].qs[iqs];
+
+    v.x = d * kvalues_iq4nl[vui & 0xF];
+    v.y = d * kvalues_iq4nl[vui >>  4];
+}
+
+static __device__ __forceinline__ void dequantize_mxfp4_b32(const void * vx, const int64_t ib, const int iqs, float2 & v){
+    const block_mxfp4 * x = (const block_mxfp4 *) vx;
+
+    const float d   = ggml_cuda_e8m0_to_fp32(x[ib].e) * 0.5f;
+    const int   vui = x[ib].qs[iqs];
+
+    v.x = d * kvalues_mxfp4[vui & 0xF];
+    v.y = d * kvalues_mxfp4[vui >>  4];
+}
+
 static __device__ __forceinline__ void dequantize_q4_0(const void * vx, const int64_t ib, const int iqs, float2 & v){
     const block_q4_0 * x = (const block_q4_0 *) vx;
 
