+// Gruppen wie ggml_cuda_q6k_gfx906_gruppe (j = 0..7, vier ql-Ints, 32 Gewichte, zwei
+// q8_1-Bloecke mit je vier Ints). block_q6_K ist 210 Byte, darum get_int_b2.
+template <int ncols, int TPR, int KC>
+__launch_bounds__(256, 2)
+static __global__ void mul_mat_vec_q6_K_breit_gfx906(
+        const void * __restrict__ vx, const void * __restrict__ vy, float * __restrict__ dst,
+        const uint32_t ncols_x, const uint32_t nrows_x, const uint32_t stride_row_x,
+        const uint32_t stride_col_y, const uint32_t stride_col_dst,
+        const uint3 channel_ratio, const uint32_t stride_channel_x,
+        const uint32_t stride_channel_y, const uint32_t stride_channel_dst,
+        const uint3 sample_ratio, const uint32_t stride_sample_x,
+        const uint32_t stride_sample_y, const uint32_t stride_sample_dst) {
+    constexpr int NT   = 256;
+    constexpr int ROWS = NT / TPR;
+    constexpr int NB   = KC * (QK_K/QK8_1);   // q8_1-Bloecke je Abschnitt
+    static_assert((KC*8) % TPR == 0, "Gruppen je Abschnitt muessen auf die Threads je Zeile aufgehen");
+
+    __shared__ int4  y_qs[ncols][NB][2];
+    __shared__ float y_d[ncols][NB];
+
+    const int tid = threadIdx.x;
+    const int rg  = tid / TPR;
+    const int tr  = tid % TPR;
+    const int row = blockIdx.x * ROWS + rg;
+    const bool row_ok = (uint32_t) row < nrows_x;
+
+    const uint32_t channel_dst = blockIdx.y;
+    const uint32_t channel_x   = fastdiv(channel_dst, channel_ratio);
+    const uint32_t sample_dst  = blockIdx.z;
+    const uint32_t sample_x    = fastdiv(sample_dst, sample_ratio);
+
+    const int blocks_per_row = ncols_x / QK_K;
+
+    const block_q6_K * x = (const block_q6_K *) vx
+        + sample_x*stride_sample_x + channel_x*stride_channel_x + (size_t) (row_ok ? row : 0)*stride_row_x;
+    const block_q8_1 * y = (const block_q8_1 *) vy
+        + sample_dst*stride_sample_y + channel_dst*stride_channel_y;
+
+    float acc[ncols];
+#pragma unroll
+    for (int j = 0; j < ncols; ++j) {
+        acc[j] = 0.0f;
+    }
+
+    for (int kb0 = 0; kb0 < blocks_per_row; kb0 += KC) {
+        const int nkb = min(KC, blocks_per_row - kb0);
+        __syncthreads();
+        const int nbl = nkb * (QK_K/QK8_1);
+        for (int i = tid; i < ncols*nbl; i += NT) {
+            const int j  = i / nbl;
+            const int b  = i - j*nbl;
+            const block_q8_1 * by = y + j*stride_col_y + kb0*(QK_K/QK8_1) + b;
+            int u[8];
+#pragma unroll
+            for (int q = 0; q < 8; ++q) {
+                u[q] = get_int_b4(by->qs, q);
+            }
+            y_qs[j][b][0] = make_int4(u[0], u[1], u[2], u[3]);
+            y_qs[j][b][1] = make_int4(u[4], u[5], u[6], u[7]);
+            y_d[j][b] = __low2float(by->ds);
+        }
+        __syncthreads();
+
+        if (!row_ok) {
+            continue;
+        }
+
+        for (int g = tr; g < nkb*8; g += TPR) {
+            const int ib   = g >> 3;
+            const int jg   = g & 7;
+            const int iqs0 = 4*jg;
+            const block_q6_K * bx = x + kb0 + ib;
+
+            const int qh_basis = 8*(iqs0/16) + iqs0 % 8;
+            const int vh_shift = 2*((iqs0 % 16) / 8);
+            const int8_t * sc  = bx->scales + 8*(iqs0/16) + (iqs0 % 16)/4;
+            const int bq8      = 4*(iqs0/16) + (iqs0 % 16)/8;   // erster q8_1-Block der Gruppe
+            const int uq       = (iqs0 % QI8_1) / 4;            // 0 oder 1: welches int4 im Block
+
+            int vi[4][2];
+#pragma unroll
+            for (int t = 0; t < 4; ++t) {
+                const int vl = get_int_b2(bx->ql, iqs0 + t);
+                const int vh = get_int_b2(bx->qh, qh_basis + t) >> vh_shift;
+#pragma unroll
+                for (int i = 0; i < 2; ++i) {
+                    const int vil = (vl >> (4*i)) & 0x0F0F0F0F;
+                    const int vih = ((vh >> (4*i)) << 4) & 0x30303030;
+                    vi[t][i] = __vsubss4((vil | vih), 0x20202020);
+                }
+            }
+            const float d   = __half2float(bx->d);
+            const float ds0 = d * (float) sc[0];
+            const float ds1 = d * (float) sc[4];
+
+            const int b0 = ib*(QK_K/QK8_1) + bq8;
+            const int b1 = b0 + 2;
+#pragma unroll
+            for (int j = 0; j < ncols; ++j) {
+                const int4 a0 = y_qs[j][b0][uq];
+                const int4 a1 = y_qs[j][b1][uq];
+                int dot0 = 0, dot1 = 0;
+                dot0 = ggml_cuda_dp4a(vi[0][0], a0.x, dot0);
+                dot0 = ggml_cuda_dp4a(vi[1][0], a0.y, dot0);
+                dot0 = ggml_cuda_dp4a(vi[2][0], a0.z, dot0);
+                dot0 = ggml_cuda_dp4a(vi[3][0], a0.w, dot0);
+                dot1 = ggml_cuda_dp4a(vi[0][1], a1.x, dot1);
+                dot1 = ggml_cuda_dp4a(vi[1][1], a1.y, dot1);
+                dot1 = ggml_cuda_dp4a(vi[2][1], a1.z, dot1);
+                dot1 = ggml_cuda_dp4a(vi[3][1], a1.w, dot1);
+                acc[j] += y_d[j][b0] * ((float) dot0 * ds0) + y_d[j][b1] * ((float) dot1 * ds1);
+            }
+        }
+    }
+
+#pragma unroll
+    for (int j = 0; j < ncols; ++j) {
+        acc[j] = warp_reduce_sum<TPR>(acc[j]);
+    }
+    if (row_ok && tr == 0) {
+        float * d = dst + sample_dst*stride_sample_dst + channel_dst*stride_channel_dst + row;
+#pragma unroll
+        for (int j = 0; j < ncols; ++j) {
+            d[j*stride_col_dst] = acc[j];
+        }
+    }
+}
+
+template <int ncols>
+static void mul_mat_vec_q6_K_breit_gfx906_start(
+        const void * vx, const void * vy, float * dst,
+        const int ncols_x, const int nrows_x, const int stride_row_x,
+        const int stride_col_y, const int stride_col_dst,
+        const uint3 channel_ratio, const int nchannels_dst, const int stride_channel_x,
+        const int stride_channel_y, const int stride_channel_dst,
+        const uint3 sample_ratio, const int nsamples_dst, const int stride_sample_x,
+        const int stride_sample_y, const int stride_sample_dst, cudaStream_t stream) {
+    static const int kc_env = getenv("GGML_MMVQ_Q6K_BREIT_KC") ? atoi(getenv("GGML_MMVQ_Q6K_BREIT_KC")) : 0;
+    const int kc = kc_env ? kc_env : (ncols > 5 ? 4 : 8);
+    const dim3 block_dims(256, 1, 1);
+    const dim3 block_nums((nrows_x + 15) / 16, nchannels_dst, nsamples_dst);
+#define GGML_Q6K_BREIT_LOS(K) mul_mat_vec_q6_K_breit_gfx906<ncols, 16, K><<<block_nums, block_dims, 0, stream>>>( \
+        vx, vy, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst, \
+        channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst, \
+        sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst)
+    if (kc == 4) {
+        GGML_Q6K_BREIT_LOS(4);
+    } else {
+        GGML_Q6K_BREIT_LOS(8);
+    }
+#undef GGML_Q6K_BREIT_LOS
+}
+
+// gfx906: breiter Q4_1-GEMV fuer 2 bis 8 Spalten. Wie Q4_0 breit, nur mit block_q4_1
+// (20 Byte, dm = d und m, alles 4-Byte-ausgerichtet, kein alignbit) und dem Epilog
+// aus vec_dot_q4_1_q8_1_impl<4>: d4*d8*sumi + m4*s8.
+template <int ncols, int TPR, int KC>
+__launch_bounds__(256, 2)
+static __global__ void mul_mat_vec_q4_1_breit_gfx906(
+        const void * __restrict__ vx, const void * __restrict__ vy, float * __restrict__ dst,
+        const uint32_t ncols_x, const uint32_t nrows_x, const uint32_t stride_row_x,
+        const uint32_t stride_col_y, const uint32_t stride_col_dst,
+        const uint3 channel_ratio, const uint32_t stride_channel_x,
+        const uint32_t stride_channel_y, const uint32_t stride_channel_dst,
+        const uint3 sample_ratio, const uint32_t stride_sample_x,
+        const uint32_t stride_sample_y, const uint32_t stride_sample_dst) {
+    constexpr int NP   = KC / 2;
+    constexpr int NT   = 256;
+    constexpr int ROWS = NT / TPR;
+    static_assert(KC % 2 == 0 && NP % TPR == 0, "Abschnitt muss in Paare je Zeilengruppe aufgehen");
+
+    __shared__ int4   y_qs[ncols][NP][5];
+    __shared__ float4 y_ds[ncols][NP];
+
+    const int tid = threadIdx.x;
+    const int rg  = tid / TPR;
+    const int tr  = tid % TPR;
+    const int row = blockIdx.x * ROWS + rg;
+    const bool row_ok = (uint32_t) row < nrows_x;
+
+    const uint32_t channel_dst = blockIdx.y;
+    const uint32_t channel_x   = fastdiv(channel_dst, channel_ratio);
+    const uint32_t sample_dst  = blockIdx.z;
+    const uint32_t sample_x    = fastdiv(sample_dst, sample_ratio);
+
+    const int blocks_per_row = ncols_x / QK4_1;
+
+    const block_q4_1 * x = (const block_q4_1 *) vx
+        + sample_x*stride_sample_x + channel_x*stride_channel_x + (size_t) (row_ok ? row : 0)*stride_row_x;
+    const block_q8_1 * y = (const block_q8_1 *) vy
+        + sample_dst*stride_sample_y + channel_dst*stride_channel_y;
+
+    float acc[ncols];
+#pragma unroll
+    for (int j = 0; j < ncols; ++j) {
+        acc[j] = 0.0f;
+    }
+
+    for (int kb0 = 0; kb0 < blocks_per_row; kb0 += KC) {
+        const int nkb = min(KC, blocks_per_row - kb0);
+        __syncthreads();
+        for (int i = tid; i < ncols*nkb; i += NT) {
+            const int j  = i / nkb;
+            const int kb = i - j*nkb;
+            const block_q8_1 * by = y + j*stride_col_y + kb0 + kb;
+            int u[8];
+#pragma unroll
+            for (int q = 0; q < 8; ++q) {
+                u[q] = get_int_b4(by->qs, q);
+            }
+            const int h = (kb & 1) * 2;
+            y_qs[j][kb >> 1][h]     = make_int4(u[0], u[1], u[2], u[3]);
+            y_qs[j][kb >> 1][h + 1] = make_int4(u[4], u[5], u[6], u[7]);
+            const float2 ds = __half22float2(by->ds);
+            if (kb & 1) {
+                y_ds[j][kb >> 1].z = ds.x;
+                y_ds[j][kb >> 1].w = ds.y;
+            } else {
+                y_ds[j][kb >> 1].x = ds.x;
+                y_ds[j][kb >> 1].y = ds.y;
+            }
+        }
+        __syncthreads();
+
+        if (!row_ok) {
+            continue;
+        }
+
+        for (int p = tr; p < nkb/2; p += TPR) {
+            const block_q4_1 * b0 = x + kb0 + 2*p;
+            const block_q4_1 * b1 = b0 + 1;
+            const float2 dm0 = __half22float2(b0->dm);
+            const float2 dm1 = __half22float2(b1->dm);
+            int vl[8], vh[8];
+#pragma unroll
+            for (int q = 0; q < 4; ++q) {
+                const int v0 = get_int_b4(b0->qs, q);
+                const int v1 = get_int_b4(b1->qs, q);
+                vl[q]     = (v0 >> 0) & 0x0F0F0F0F;
+                vh[q]     = (v0 >> 4) & 0x0F0F0F0F;
+                vl[4 + q] = (v1 >> 0) & 0x0F0F0F0F;
+                vh[4 + q] = (v1 >> 4) & 0x0F0F0F0F;
+            }
+#pragma unroll
+            for (int j = 0; j < ncols; ++j) {
+                const int4 u0 = y_qs[j][p][0];
+                const int4 u1 = y_qs[j][p][1];
+                const int4 u2 = y_qs[j][p][2];
+                const int4 u3 = y_qs[j][p][3];
+                int sumi0 = 0;
+                sumi0 = ggml_cuda_dp4a(vl[0], u0.x, sumi0);
+                sumi0 = ggml_cuda_dp4a(vl[1], u0.y, sumi0);
+                sumi0 = ggml_cuda_dp4a(vl[2], u0.z, sumi0);
+                sumi0 = ggml_cuda_dp4a(vl[3], u0.w, sumi0);
+                sumi0 = ggml_cuda_dp4a(vh[0], u1.x, sumi0);
+                sumi0 = ggml_cuda_dp4a(vh[1], u1.y, sumi0);
+                sumi0 = ggml_cuda_dp4a(vh[2], u1.z, sumi0);
+                sumi0 = ggml_cuda_dp4a(vh[3], u1.w, sumi0);
+                int sumi1 = 0;
+                sumi1 = ggml_cuda_dp4a(vl[4], u2.x, sumi1);
+                sumi1 = ggml_cuda_dp4a(vl[5], u2.y, sumi1);
+                sumi1 = ggml_cuda_dp4a(vl[6], u2.z, sumi1);
+                sumi1 = ggml_cuda_dp4a(vl[7], u2.w, sumi1);
+                sumi1 = ggml_cuda_dp4a(vh[4], u3.x, sumi1);
+                sumi1 = ggml_cuda_dp4a(vh[5], u3.y, sumi1);
+                sumi1 = ggml_cuda_dp4a(vh[6], u3.z, sumi1);
+                sumi1 = ggml_cuda_dp4a(vh[7], u3.w, sumi1);
+                const float4 ds = y_ds[j][p];
+                acc[j] += (float) sumi0 * (dm0.x * ds.x) + dm0.y * ds.y
+                        + (float) sumi1 * (dm1.x * ds.z) + dm1.y * ds.w;
+            }
+        }
+    }
+
+#pragma unroll
+    for (int j = 0; j < ncols; ++j) {
+        acc[j] = warp_reduce_sum<TPR>(acc[j]);
+    }
+    if (row_ok && tr == 0) {
+        float * d = dst + sample_dst*stride_sample_dst + channel_dst*stride_channel_dst + row;
+#pragma unroll
+        for (int j = 0; j < ncols; ++j) {
+            d[j*stride_col_dst] = acc[j];
+        }
+    }
+}
+
+template <int ncols>
+static void mul_mat_vec_q4_1_breit_gfx906_start(
+        const void * vx, const void * vy, float * dst,
+        const int ncols_x, const int nrows_x, const int stride_row_x,
+        const int stride_col_y, const int stride_col_dst,
+        const uint3 channel_ratio, const int nchannels_dst, const int stride_channel_x,
+        const int stride_channel_y, const int stride_channel_dst,
+        const uint3 sample_ratio, const int nsamples_dst, const int stride_sample_x,
+        const int stride_sample_y, const int stride_sample_dst, cudaStream_t stream) {
+    const dim3 block_dims(256, 1, 1);
+    const dim3 block_nums((nrows_x + 15) / 16, nchannels_dst, nsamples_dst);
+    if (ncols > 5) {
+        mul_mat_vec_q4_1_breit_gfx906<ncols, 16, 32><<<block_nums, block_dims, 0, stream>>>(
+            vx, vy, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst,
+            channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+            sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst);
+    } else {
+        mul_mat_vec_q4_1_breit_gfx906<ncols, 16, 64><<<block_nums, block_dims, 0, stream>>>(
+            vx, vy, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst,
+            channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+            sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst);
+    }
+}
+#endif // defined(GGML_USE_HIP)
+
+// gfx906: Q2_K-GEMV, ein Thread je vier qs-Ints (64 Gewichte).
+//
+// Anteile in den Modellen hier: 7,2 % der Gewichte in Qwen3.8-27B-UD-Q2_K_XL,
+// 6,0 % in UD-IQ2_S — beide Stufen der Qualitaetsleiter.
+//
+// Ein Thread des Standardpfads nimmt einen qs-Int (iqs) und je einen y-Int aus vier
+// verschiedenen q8_1-Bloecken — fuenf schmale Zugriffe. Hier nimmt er iqs = 4j..4j+3;
+// damit werden daraus fuenf `dwordx4`, und bq8_offset wie scale_offset sind im Thread
+// konstant (fuer j = 0..3: scale_offset 0, 1, 8, 9).
+//
+// Der ds.y-Trick von Q4_K/Q5_K geht hier *nicht*: ein Thread deckt nur vier der acht
+// Ints eines q8_1-Blocks ab, die Blocksumme passt also nicht. Der m-Term bleibt.
+//
+// block_q2_K ist 84 Byte gross und damit 4-Byte-ausgerichtet.
+static __device__ __forceinline__ float ggml_cuda_q2k_gfx906_gruppe(
+        const block_q2_K * __restrict__ bx, const int j,
+        const int * __restrict__ u, const float * __restrict__ d8) {
+
+    const int iqs0         = 4*j;
+    const int scale_offset = iqs0 - iqs0 % QI8_1 + (iqs0 % QI8_1) / (QI8_1/2);
+    const uint8_t * scales = bx->scales + scale_offset;
+
+    int v[4];
+    {
+        const int * qs = (const int *) bx->qs + iqs0;
+#pragma unroll
+        for (int t = 0; t < 4; ++t) {
+            v[t] = qs[t];
+        }
+    }
+
+    float sumf_d = 0.0f;
+    float sumf_m = 0.0f;
+#pragma unroll
+    for (int t = 0; t < 4; ++t) {
+#pragma unroll
+        for (int i = 0; i < QR2_K; ++i) {
+            const int sc = scales[2*i];
+            const int vi = (v[t] >> (2*i)) & 0x03030303;
+
+            sumf_d += d8[i] * (ggml_cuda_dp4a(vi, u[4*i + t], 0) * (sc & 0xF));
+
+            int m = sc >> 4;
+            m |= m <<  8;
+            m |= m << 16;
+            sumf_m += d8[i] * ggml_cuda_dp4a(m, u[4*i + t], 0);
+        }
+    }
+
+    const float2 dm2f = __half22float2(bx->dm);
+    return dm2f.x*sumf_d - dm2f.y*sumf_m;
+}
+
+// Vorgabe an; mit GGML_MMVQ_Q2K_GFX906=0 abschaltbar.
+template <bool has_fusion>
+__launch_bounds__(64, 1)
+static __global__ void mul_mat_vec_q2_K_gfx906(
+        const void * __restrict__ vx, const void * __restrict__ vy,
+        const ggml_cuda_mm_fusion_args_device fusion, float * __restrict__ dst,
+        const uint32_t ncols_x, const uint32_t nrows_x, const uint32_t stride_row_x,
+        const uint3 channel_ratio, const uint32_t stride_channel_x,
+        const uint32_t stride_channel_y, const uint32_t stride_channel_dst,
+        const uint3 sample_ratio, const uint32_t stride_sample_x,
+        const uint32_t stride_sample_y, const uint32_t stride_sample_dst) {
+
+    const int lane      = threadIdx.x;
+    const int half_lane = lane % 32;
+    const int row       = blockIdx.x * 2 + lane / 32;
+    if ((uint32_t) row >= nrows_x) {
+        return;
+    }
+
+    const uint32_t channel_dst = blockIdx.y;
+    const uint32_t channel_x   = fastdiv(channel_dst, channel_ratio);
+    const uint32_t sample_dst  = blockIdx.z;
+    const uint32_t sample_x    = fastdiv(sample_dst, sample_ratio);
+
+    const int blocks_per_row = ncols_x / QK_K;
+    const int groups_per_row = blocks_per_row * 4;   // je 64 Gewichte
+
+    const block_q2_K * x = (const block_q2_K *) vx
+        + sample_x*stride_sample_x + channel_x*stride_channel_x + (size_t) row*stride_row_x;
+    const block_q8_1 * y = (const block_q8_1 *) vy
+        + sample_dst*stride_sample_y + channel_dst*stride_channel_y;
+
+    [[maybe_unused]] const block_q2_K * xg = nullptr;
+    [[maybe_unused]] bool use_gate = false;
+    if constexpr (has_fusion) {
+        use_gate = fusion.gate != nullptr;
+        if (use_gate) {
+            xg = (const block_q2_K *) fusion.gate
+                + sample_x*stride_sample_x + channel_x*stride_channel_x + (size_t) row*stride_row_x;
+        }
+    }
+
+    float sumf  = 0.0f;
+    float sumfg = 0.0f;
+
+    for (int g = half_lane; g < groups_per_row; g += 32) {
+        const int ib   = g / 4;
+        const int j    = g % 4;
+        const int iqs0 = 4*j;
+
+        const int bq8_offset = QR2_K * (iqs0 / QI8_1);
+        const int u_basis    = iqs0 % QI8_1;
+
+        int u[4*QR2_K];
+        float d8[QR2_K];
+#pragma unroll
+        for (int i = 0; i < QR2_K; ++i) {
+            const block_q8_1 * byi = y + ib*(QK_K/QK8_1) + bq8_offset + i;
+            d8[i] = __low2float(byi->ds);
+#pragma unroll
+            for (int t = 0; t < 4; ++t) {
+                u[4*i + t] = get_int_b4(byi->qs, u_basis + t);
+            }
+        }
+
+        sumf += ggml_cuda_q2k_gfx906_gruppe(x + ib, j, u, d8);
+
+        if constexpr (has_fusion) {
+            if (use_gate) {
+                sumfg += ggml_cuda_q2k_gfx906_gruppe(xg + ib, j, u, d8);
+            }
+        }
+    }
+
+    sumf = warp_reduce_sum<32>(sumf);
+    if constexpr (has_fusion) {
+        if (use_gate) {
+            sumfg = warp_reduce_sum<32>(sumfg);
+        }
+    }
+
+    if (half_lane != 0) {
+        return;
+    }
+
+    float result = sumf;
+    if constexpr (has_fusion) {
+        const size_t versatz = sample_dst*stride_sample_dst + channel_dst*stride_channel_dst + row;
+        result = ggml_cuda_gfx906_glu_epilog(fusion, use_gate, versatz, result, sumfg);
+    }
+
+    dst[sample_dst*stride_sample_dst + channel_dst*stride_channel_dst + row] = result;
+}
+
+
+// gfx906: Q3_K-GEMV, ein Thread je vier qs-Ints (64 Gewichte).
+//
+// Baugleich zu Q2_K: iqs = 4j..4j+3, damit liegen qs, hmask und die y-Ints der vier
+// q8_1-Bloecke je zusammenhaengend; bq8_offset und scale_offset sind im Thread konstant.
+// block_q3_K ist 110 Byte gross und damit nur 2-Byte-ausgerichtet — get_int_b2 wie
+// bei Q6_K.
+static __device__ __forceinline__ float ggml_cuda_q3k_gfx906_gruppe(
+        const block_q3_K * __restrict__ bx, const int j,
+        const int * __restrict__ u, const float * __restrict__ d8) {
+
+    const int iqs0         = 4*j;
+    const int bq8_offset   = QR3_K * (iqs0 / (QI3_K/2));
+    const int scale_offset = iqs0 - iqs0 % QI8_1 + (iqs0 % QI8_1) / (QI8_1/2);
+    const int hbasis       = iqs0 % (QI3_K/2);
+
+    int vl[4], vh[4];
+#pragma unroll
+    for (int t = 0; t < 4; ++t) {
+        vl[t] = get_int_b2(bx->qs, iqs0 + t);
+        // Maske invertiert, damit aus 0/1 ein Abzug von 4/0 wird — wie im Standardpfad.
+        vh[t] = ~get_int_b2(bx->hmask, hbasis + t) >> bq8_offset;
+    }
+
+    const float d3 = bx->d;
+
+    float sumf = 0.0f;
+#pragma unroll
+    for (int t = 0; t < 4; ++t) {
+        sumf += vec_dot_q3_K_q8_1_impl_mmvq(vl[t], vh[t], u + 4*t, bx->scales, scale_offset, 1.0f, d8);
+    }
+
+    return d3 * sumf;
+}
+
+// Vorgabe aus — GEMESSEN UND VERWORFEN, siehe Verteiler unten.
+template <bool has_fusion>
+__launch_bounds__(64, 1)
+static __global__ void mul_mat_vec_q3_K_gfx906(
+        const void * __restrict__ vx, const void * __restrict__ vy,
+        const ggml_cuda_mm_fusion_args_device fusion, float * __restrict__ dst,
+        const uint32_t ncols_x, const uint32_t nrows_x, const uint32_t stride_row_x,
+        const uint3 channel_ratio, const uint32_t stride_channel_x,
+        const uint32_t stride_channel_y, const uint32_t stride_channel_dst,
+        const uint3 sample_ratio, const uint32_t stride_sample_x,
+        const uint32_t stride_sample_y, const uint32_t stride_sample_dst) {
+
+    const int lane      = threadIdx.x;
+    const int half_lane = lane % 32;
+    const int row       = blockIdx.x * 2 + lane / 32;
+    if ((uint32_t) row >= nrows_x) {
+        return;
+    }
+
+    const uint32_t channel_dst = blockIdx.y;
+    const uint32_t channel_x   = fastdiv(channel_dst, channel_ratio);
+    const uint32_t sample_dst  = blockIdx.z;
+    const uint32_t sample_x    = fastdiv(sample_dst, sample_ratio);
+
+    const int blocks_per_row = ncols_x / QK_K;
+    const int groups_per_row = blocks_per_row * 4;
+
+    const block_q3_K * x = (const block_q3_K *) vx
+        + sample_x*stride_sample_x + channel_x*stride_channel_x + (size_t) row*stride_row_x;
+    const block_q8_1 * y = (const block_q8_1 *) vy
+        + sample_dst*stride_sample_y + channel_dst*stride_channel_y;
+
+    [[maybe_unused]] const block_q3_K * xg = nullptr;
+    [[maybe_unused]] bool use_gate = false;
+    if constexpr (has_fusion) {
+        use_gate = fusion.gate != nullptr;
+        if (use_gate) {
+            xg = (const block_q3_K *) fusion.gate
+                + sample_x*stride_sample_x + channel_x*stride_channel_x + (size_t) row*stride_row_x;
+        }
+    }
+
+    float sumf  = 0.0f;
+    float sumfg = 0.0f;
+
+    for (int g = half_lane; g < groups_per_row; g += 32) {
+        const int ib   = g / 4;
+        const int j    = g % 4;
+        const int iqs0 = 4*j;
+
+        const int bq8_offset = QR3_K * (iqs0 / (QI3_K/2));
+        const int u_basis    = iqs0 % QI8_1;
+
+        int u[4*QR3_K];
+        float d8[QR3_K];
+#pragma unroll
+        for (int i = 0; i < QR3_K; ++i) {
+            const block_q8_1 * byi = y + ib*(QK_K/QK8_1) + bq8_offset + i;
+            d8[i] = __low2float(byi->ds);
+#pragma unroll
+            for (int t = 0; t < 4; ++t) {
+                u[4*t + i] = get_int_b4(byi->qs, u_basis + t);
+            }
+        }
+
+        sumf += ggml_cuda_q3k_gfx906_gruppe(x + ib, j, u, d8);
+
+        if constexpr (has_fusion) {
+            if (use_gate) {
+                sumfg += ggml_cuda_q3k_gfx906_gruppe(xg + ib, j, u, d8);
+            }
+        }
+    }
+
+    sumf = warp_reduce_sum<32>(sumf);
+    if constexpr (has_fusion) {
+        if (use_gate) {
+            sumfg = warp_reduce_sum<32>(sumfg);
+        }
+    }
+
+    if (half_lane != 0) {
+        return;
+    }
+
+    float result = sumf;
+    if constexpr (has_fusion) {
+        const size_t versatz = sample_dst*stride_sample_dst + channel_dst*stride_channel_dst + row;
+        result = ggml_cuda_gfx906_glu_epilog(fusion, use_gate, versatz, result, sumfg);
+    }
+
+    dst[sample_dst*stride_sample_dst + channel_dst*stride_channel_dst + row] = result;
+}
