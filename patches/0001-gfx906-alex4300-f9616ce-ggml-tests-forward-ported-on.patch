+// Zwischenspeicher fuer quantisierte Aktivierungen.
+//
+// Jeder Matmul quantisiert sein src1 selbst. Bei einem dichten Modell teilen sich
+// q, k und v denselben Eingang, und dieselbe Aktivierung wird mehrfach quantisiert.
+// Gemessen am 2026-08-31 im Decode (Zaehler an der Quantisierungsstelle, Schluessel
+// ist die Tensor-Identitaet):
+//
+//   Qwen3.8-27B UD-IQ4_XS    44,3 % der Quantisierungen wiederholt
+//   Qwen3.8-27B UD-Q2_K_XL   44,4 %
+//   Qwen3-8B-Q4_K_M          33,2 %
+//   Qwen3.8-27B Q4_0         23,7 %
+//   Flash-Next UD-Q2_K_XL    11,2 %   (MoE: Experten haben verschiedene Eingaenge)
+//
+// Der Schluessel muss die **Tensor-Identitaet** sein, nicht die Adresse: ggml
+// verwendet Puffer wieder, und ein toter Tensor teilt sich seine Adresse mit einem
+// spaeteren. Mit dem Datenzeiger kamen 89,4 % heraus statt 11,2 %.
+//
+// Der Speicher wird zu Beginn jedes Graphdurchlaufs freigegeben. Innerhalb eines
+// Durchlaufs ist ein Tensor genau einmal beschrieben, der Inhalt also gueltig.
+// Siehe kernel-arbeit/ergebnis-quant-zwischenspeicher-2026-08-31.md.
+// Obergrenzen, damit der Prefill nicht hunderte MB im Pool festhaelt.
+#define GGML_CUDA_Q8_1_CACHE_MAX_BYTES (4u  * 1024 * 1024)
+#define GGML_CUDA_Q8_1_CACHE_BUDGET    (64u * 1024 * 1024)
+
+struct ggml_cuda_q8_1_cache_key {
+    const void * src1;
+    int      layout;
+    int64_t  ne10, s11, ne11, nmat;
+    bool operator==(const ggml_cuda_q8_1_cache_key & o) const {
+        return src1 == o.src1 && layout == o.layout && ne10 == o.ne10 &&
+               s11 == o.s11 && ne11 == o.ne11 && nmat == o.nmat;
+    }
+};
+
+struct ggml_cuda_q8_1_cache_entry {
+    ggml_cuda_q8_1_cache_key                        key;
+    std::unique_ptr<ggml_cuda_pool_alloc<char>>     halter;
+};
+
 struct ggml_backend_cuda_context {
     int device;
     std::string name;
@@ -1469,6 +1508,38 @@ struct ggml_backend_cuda_context {
     // when the computation is split across CPU/GPU (e.g., with --n-cpu-moe)
     std::unordered_map<const void *, std::unique_ptr<ggml_cuda_graph>> cuda_graphs;
 
+    // siehe ggml_cuda_q8_1_cache_entry oben
+    std::vector<ggml_cuda_q8_1_cache_entry> q8_1_cache;
+
+    char * q8_1_cache_suchen(const ggml_cuda_q8_1_cache_key & k) {
+        for (const auto & e : q8_1_cache) {
+            if (e.key == k) {
+                return e.halter->get();
+            }
+        }
+        return nullptr;
+    }
+
+    size_t q8_1_cache_bytes = 0;
+
+    // Die Zuteilung selbst aufbewahren, nicht Zeiger und Groesse: pool() haengt an
+    // curr_stream_no, und wer spaeter freigibt, trifft sonst womoeglich einen
+    // anderen Pool als den, aus dem der Puffer kam. Der Destruktor von
+    // ggml_cuda_pool_alloc merkt sich seinen Pool.
+    char * q8_1_cache_ablegen(const ggml_cuda_q8_1_cache_key & k, size_t bytes) {
+        auto halter = std::unique_ptr<ggml_cuda_pool_alloc<char>>(
+            new ggml_cuda_pool_alloc<char>(pool(), bytes));
+        char * p = halter->get();
+        q8_1_cache.push_back({ k, std::move(halter) });
+        q8_1_cache_bytes += bytes;
+        return p;
+    }
+
+    void q8_1_cache_leeren() {
+        q8_1_cache.clear();          // Destruktoren geben an den richtigen Pool zurueck
+        q8_1_cache_bytes = 0;
+    }
+
     int64_t last_graph_eviction_sweep = 0;
 
     ggml_cuda_graph * cuda_graph(const void * first_node_ptr) {
