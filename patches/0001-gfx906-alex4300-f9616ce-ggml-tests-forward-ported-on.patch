+#if defined(GGML_USE_HIP)
+// gfx906: breiter Q5_K-GEMV fuer 2 bis 8 Spalten, Struktur wie mul_mat_vec_q4_0_breit_gfx906:
+// eine Arbeitsgruppe von 256 Threads holt einen y-Abschnitt (KC Superbloecke, alle Spalten)
+// einmal in den LDS, jeder Thread nimmt il-Gruppen (64 Gewichte, zwei q8_1-Bloecke) seiner
+// Zeile, entpackt die 5-Bit-Werte und Skalen EINMAL und bildet dann je Spalte 16 dp4a.
+// Der allgemeine MMVQ-Kernel entpackt je Spalte neu und liest y je Zeilenblock aus dem L2;
+// gemessen 409 us je 21,7-MB-Tensor bei n=8 gegen 39 us bei n=1 (ergebnis-schrittprofil).
+//
+// Rechenweg je Gruppe wie ggml_cuda_q5k_gfx906_gruppe / vec_dot_q5_K_q8_1_impl_d_gfx906:
+//   dm.x * sum_i d8[i]*sc[i]*dot_i  -  dm.y * (s8_0*m[0] + s8_1*m[1]),
+//   dot_i = sum_k dp4a(w[k][i][0], u_i[k]) + dp4a(w[k][i][1], u_i[k+4]).
+// Bedingungen (Host): ncols_x % 256 == 0, keine ids, keine Fusion (gibt es fuer n > 1 nicht).
+// Vorgabe an, mit GGML_MMVQ_Q5K_BREIT_GFX906=0 abschaltbar; GGML_MMVQ_Q5K_BREIT_KC=4|8 fuer Messreihen.
+template <int ncols, int TPR, int KC>
+__launch_bounds__(256, 2)
+static __global__ void mul_mat_vec_q5_K_breit_gfx906(
+        const void * __restrict__ vx, const void * __restrict__ vy, float * __restrict__ dst,
+        const uint32_t ncols_x, const uint32_t nrows_x, const uint32_t stride_row_x,
+        const uint32_t stride_col_y, const uint32_t stride_col_dst,
+        const uint3 channel_ratio, const uint32_t stride_channel_x,
+        const uint32_t stride_channel_y, const uint32_t stride_channel_dst,
+        const uint3 sample_ratio, const uint32_t stride_sample_x,
+        const uint32_t stride_sample_y, const uint32_t stride_sample_dst) {
+    constexpr int NT   = 256;
+    constexpr int ROWS = NT / TPR;
+    constexpr int NG   = KC * 4;              // il-Gruppen je Abschnitt
+    static_assert(NG % TPR == 0, "Gruppen je Abschnitt muessen auf die Threads je Zeile aufgehen");
+
+    __shared__ int4   y_qs[ncols][NG][5];     // 4 int4 Nutzlast (zwei q8_1-Bloecke) + 1 Polster
+    __shared__ float4 y_ds[ncols][NG];        // d0, s0, d1, s1
+
+    const int tid = threadIdx.x;
+    const int rg  = tid / TPR;
+    const int tr  = tid % TPR;
+    const int row = blockIdx.x * ROWS + rg;
+    const bool row_ok = (uint32_t) row < nrows_x;
+
+    const uint32_t channel_dst = blockIdx.y;
+    const uint32_t channel_x   = fastdiv(channel_dst, channel_ratio);
+    const uint32_t sample_dst  = blockIdx.z;
+    const uint32_t sample_x    = fastdiv(sample_dst, sample_ratio);
+
+    const int blocks_per_row = ncols_x / QK_K;
+
+    const block_q5_K * x = (const block_q5_K *) vx
+        + sample_x*stride_sample_x + channel_x*stride_channel_x + (size_t) (row_ok ? row : 0)*stride_row_x;
+    const block_q8_1 * y = (const block_q8_1 *) vy
+        + sample_dst*stride_sample_y + channel_dst*stride_channel_y;
+
+    float acc[ncols];
+#pragma unroll
+    for (int j = 0; j < ncols; ++j) {
+        acc[j] = 0.0f;
+    }
+
+    for (int kb0 = 0; kb0 < blocks_per_row; kb0 += KC) {
+        const int nkb = min(KC, blocks_per_row - kb0);
+        __syncthreads();
+
+        // y-Abschnitt: ncols * nkb * 8 q8_1-Bloecke
+        const int nbl = nkb * (QK_K/QK8_1);
+        for (int i = tid; i < ncols*nbl; i += NT) {
+            const int j  = i / nbl;
+            const int b  = i - j*nbl;                 // q8_1-Block innerhalb des Abschnitts
+            const block_q8_1 * by = y + j*stride_col_y + kb0*(QK_K/QK8_1) + b;
+            int u[8];
+#pragma unroll
+            for (int q = 0; q < 8; ++q) {
+                u[q] = get_int_b4(by->qs, q);
+            }
+            const int g = b >> 1;
+            const int h = (b & 1) * 2;
+            y_qs[j][g][h]     = make_int4(u[0], u[1], u[2], u[3]);
+            y_qs[j][g][h + 1] = make_int4(u[4], u[5], u[6], u[7]);
+            const float2 ds = __half22float2(by->ds);
+            if (b & 1) {
+                y_ds[j][g].z = ds.x;
+                y_ds[j][g].w = ds.y;
+            } else {
+                y_ds[j][g].x = ds.x;
+                y_ds[j][g].y = ds.y;
+            }
+        }
+        __syncthreads();
+
+        if (!row_ok) {
+            continue;
+        }
+
+        for (int g = tr; g < nkb*4; g += TPR) {
+            const int ib = g >> 2;
+            const int il = g & 3;
+            const block_q5_K * bx = x + kb0 + ib;
+
+            // Gewichte einmal entpacken: w[k][i][0/1] = 5-Bit-Werte als Bytes
+            int w[4][2][2];
+            {
+                const int * ql = (const int *) (bx->qs + 32*il);
+                const int * qh = (const int *) bx->qh;
+#pragma unroll
+                for (int k = 0; k < 4; ++k) {
+                    const int vl0 = ql[k];
+                    const int vl1 = ql[k + 4];
+                    const int vh0 = qh[k]     >> (2*il);
+                    const int vh1 = qh[k + 4] >> (2*il);
+#pragma unroll
+                    for (int i = 0; i < 2; ++i) {
+                        w[k][i][0] = ((vl0 >> (4*i)) & 0x0F0F0F0F) | (((vh0 >> i) << 4) & 0x10101010);
+                        w[k][i][1] = ((vl1 >> (4*i)) & 0x0F0F0F0F) | (((vh1 >> i) << 4) & 0x10101010);
+                    }
+                }
+            }
+            // Skalen und Minima wie im Standardpfad (j = il)
+            float scf[2], mf[2];
+            {
+                const uint16_t * scales = (const uint16_t *) bx->scales;
+                uint16_t aux[2];
+                if (il < 2) {
+                    aux[0] = scales[il+0] & 0x3f3f;
+                    aux[1] = scales[il+2] & 0x3f3f;
+                } else {
+                    aux[0] = ((scales[il+2] >> 0) & 0x0f0f) | ((scales[il-2] & 0xc0c0) >> 2);
+                    aux[1] = ((scales[il+2] >> 4) & 0x0f0f) | ((scales[il-0] & 0xc0c0) >> 2);
+                }
+                const uint8_t * sc = (const uint8_t *) aux;
+                scf[0] = (float) sc[0]; scf[1] = (float) sc[1];
+                mf[0]  = (float) sc[2]; mf[1]  = (float) sc[3];
+            }
+            const float2 dm = __half22float2(bx->dm);
+            const float dsc0 = dm.x * scf[0];
+            const float dsc1 = dm.x * scf[1];
+            const float dmm0 = dm.y * mf[0];
+            const float dmm1 = dm.y * mf[1];
+
+#pragma unroll
+            for (int j = 0; j < ncols; ++j) {
+                const int4 a0 = y_qs[j][g][0];   // u0[0..3]
+                const int4 a1 = y_qs[j][g][1];   // u0[4..7]
+                const int4 a2 = y_qs[j][g][2];   // u1[0..3]
+                const int4 a3 = y_qs[j][g][3];   // u1[4..7]
+                int dot0 = 0;
+                dot0 = ggml_cuda_dp4a(w[0][0][0], a0.x, dot0);
+                dot0 = ggml_cuda_dp4a(w[1][0][0], a0.y, dot0);
+                dot0 = ggml_cuda_dp4a(w[2][0][0], a0.z, dot0);
+                dot0 = ggml_cuda_dp4a(w[3][0][0], a0.w, dot0);
+                dot0 = ggml_cuda_dp4a(w[0][0][1], a1.x, dot0);
+                dot0 = ggml_cuda_dp4a(w[1][0][1], a1.y, dot0);
+                dot0 = ggml_cuda_dp4a(w[2][0][1], a1.z, dot0);
+                dot0 = ggml_cuda_dp4a(w[3][0][1], a1.w, dot0);
+                int dot1 = 0;
+                dot1 = ggml_cuda_dp4a(w[0][1][0], a2.x, dot1);
+                dot1 = ggml_cuda_dp4a(w[1][1][0], a2.y, dot1);
+                dot1 = ggml_cuda_dp4a(w[2][1][0], a2.z, dot1);
+                dot1 = ggml_cuda_dp4a(w[3][1][0], a2.w, dot1);
+                dot1 = ggml_cuda_dp4a(w[0][1][1], a3.x, dot1);
+                dot1 = ggml_cuda_dp4a(w[1][1][1], a3.y, dot1);
+                dot1 = ggml_cuda_dp4a(w[2][1][1], a3.z, dot1);
+                dot1 = ggml_cuda_dp4a(w[3][1][1], a3.w, dot1);
+                const float4 ds = y_ds[j][g];
+                acc[j] += ds.x * ((float) dot0 * dsc0) + ds.z * ((float) dot1 * dsc1)
+                        - (ds.y * dmm0 + ds.w * dmm1);
+            }
+        }
+    }
+
+#pragma unroll
+    for (int j = 0; j < ncols; ++j) {
+        acc[j] = warp_reduce_sum<TPR>(acc[j]);
+    }
+    if (row_ok && tr == 0) {
+        float * d = dst + sample_dst*stride_sample_dst + channel_dst*stride_channel_dst + row;
+#pragma unroll
+        for (int j = 0; j < ncols; ++j) {
+            d[j*stride_col_dst] = acc[j];
+        }
+    }
+}
